.calendar-page {
  padding-bottom: 60rpx;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.brand image {
  width: 92rpx;
  height: 92rpx;
  border-radius: 28rpx;
}

.brand view {
  display: flex;
  flex-direction: column;
}

.brand text {
  font-size: 42rpx;
  font-weight: 900;
}

.brand-subtitle {
  margin-top: 4rpx;
  color: #8fa3b6;
  font-size: 24rpx;
}

.profile-button {
  min-width: 112rpx;
  min-height: 70rpx;
  border-radius: 22rpx;
  background: #fff;
  color: #587087;
  font-weight: 700;
}

.summary-row {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.summary-card {
  padding: 24rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.summary-card text {
  font-size: 46rpx;
  font-weight: 900;
}

.summary-label {
  margin-top: 4rpx;
  color: #8fa3b6;
  font-size: 21rpx;
}

.calendar-card {
  margin-top: 24rpx;
  padding: 28rpx 20rpx 24rpx;
}

.month-bar {
  display: grid;
  grid-template-columns: 72rpx 1fr 72rpx;
  align-items: center;
}

.month-bar > button {
  width: 68rpx;
  height: 68rpx;
  padding: 0;
  border-radius: 22rpx;
  background: #edf7ff;
  color: #153454;
  font-size: 48rpx;
  line-height: 64rpx;
}

.month-bar view {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.month-bar text {
  font-size: 34rpx;
  font-weight: 900;
}

.month-bar view button {
  margin-top: 4rpx;
  padding: 0;
  background: transparent;
  color: #2aa884;
  font-size: 21rpx;
  line-height: 1.5;
}

.week-row,
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
}

.week-row {
  margin-top: 26rpx;
  color: #91a4b6;
  text-align: center;
  font-size: 22rpx;
  font-weight: 700;
}

.calendar-grid {
  margin-top: 10rpx;
  gap: 7rpx 4rpx;
}

.day-cell {
  position: relative;
  height: 82rpx;
  padding: 0;
  border-radius: 20rpx;
  background: transparent;
  color: #153454;
  font-size: 25rpx;
}

.day-cell.outside {
  color: #c4d0da;
}

.day-cell.today {
  box-shadow: inset 0 0 0 3rpx #2bc099;
}

.day-cell.has-status {
  background: #eff8ff;
}

.day-cell.has-status.rest {
  background: #e9faf4;
}

.day-cell.has-status.leave {
  background: #fff5df;
}

.day-number {
  font-weight: 800;
}

.status-dot {
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #428fd6;
  transform: translateX(-50%);
}

.rest .status-dot {
  background: #2bc099;
}

.leave .status-dot {
  background: #efb33d;
}

.note-count {
  position: absolute;
  top: 5rpx;
  right: 6rpx;
  min-width: 25rpx;
  height: 25rpx;
  border-radius: 13rpx;
  background: #153454;
  color: #fff;
  font-size: 16rpx;
  line-height: 25rpx;
}

.action-row {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.sync-tip {
  padding: 28rpx 0 0;
  color: #9aabb9;
  text-align: center;
  font-size: 22rpx;
}
