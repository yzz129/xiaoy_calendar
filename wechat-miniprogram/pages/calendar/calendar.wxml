<view class="calendar-page theme-{{theme}} {{fontClass}} {{skinClass}} {{fontsReady ? 'fonts-ready' : 'fonts-loading'}}" style="{{skinStyle}}">
  <view class="app-header">
    <view class="brand-block">
      <image class="brand-mark" src="/assets/icons/doodle/mascot.svg" mode="aspectFit" />
      <view class="brand-name">小Y日历</view><view class="brand-stroke"></view>
    </view>
    <view class="header-actions">
      <view class="primary-actions">
        <view class="action primary" bindtap="goToday">今天</view>
        <view class="action plan" bindtap="openPlans"><image src="/assets/icons/lucide/clipboard-list.svg"/><text>规划中心</text><text wx:if="{{activePlanCount}}" class="badge">{{activePlanCount > 9 ? '9+' : activePlanCount}}</text></view>
      </view>
      <view class="utility-actions">
        <view class="icon-action labeled theme-entry" aria-label="打开主题设置" bindtap="openTheme"><image src="/assets/icons/lucide/moon-star.svg"/><text>主题</text></view>
        <view class="icon-action download" aria-label="下载应用" bindtap="copyDownload"><image src="/assets/icons/lucide/download.svg"/></view>
        <view wx:if="{{loggedIn && isAdmin}}" class="icon-action labeled admin" bindtap="openAdmin"><image src="/assets/icons/lucide/shield-check.svg"/><text>后台</text></view>
        <view wx:if="{{loggedIn}}" class="icon-action labeled profile" bindtap="openProfile"><image src="/assets/icons/lucide/user-round.svg"/><text>我的</text></view>
        <view wx:if="{{loggedIn}}" class="icon-action logout" aria-label="退出登录" bindtap="logout"><image src="/assets/icons/lucide/log-out.svg"/></view>
        <view wx:else class="icon-action labeled profile" bindtap="openLogin"><image src="/assets/icons/lucide/user-round.svg"/><text>登录</text></view>
      </view>
    </view>
    <view class="month-switcher">
      <view class="month-control" data-offset="-1" bindtap="changeMonth"><image src="/assets/icons/lucide/chevron-left.svg"/></view>
      <view class="month-title"><text>{{monthTitle}}</text><view></view></view>
      <view class="month-control" data-offset="1" bindtap="changeMonth"><image src="/assets/icons/lucide/chevron-right.svg"/></view>
    </view>
  </view>

  <view class="summary-strip">
    <view class="summary-tape"></view>
    <view class="summary-item mint"><image src="/assets/icons/doodle/leaf.svg"/><view><text class="summary-label">本月工作天数</text><text class="summary-value">{{stats.completed}}<text class="small">天</text></text></view></view>
    <view class="summary-item blue"><image src="/assets/icons/doodle/mascot.svg"/><view><text class="summary-label">请假</text><text class="summary-value">{{stats.leave}}<text class="small">天</text></text></view></view>
    <view class="summary-item yellow"><image src="/assets/icons/doodle/clock.svg"/><view><text class="summary-label">累计工期</text><text class="summary-value">{{stats.duration}}<text class="small">天</text></text></view></view>
  </view>

  <view class="range-summary {{rangeOpen ? 'open' : ''}}">
    <view class="range-toggle" bindtap="toggleRange">
      <view class="range-heading"><view class="range-icon"><image src="/assets/icons/lucide/calendar-range.svg"/></view><view><text>工期统计</text><text class="small">{{rangeOpen ? '选择起止日期查看合计' : '按时间段查看总工期'}}</text></view></view>
      <view class="range-result"><text>{{rangeStats.duration}}</text><text class="small">天</text></view>
      <image class="range-chevron" src="{{rangeOpen ? '/assets/icons/lucide/chevron-up.svg' : '/assets/icons/lucide/chevron-down.svg'}}"/>
    </view>
    <view wx:if="{{rangeOpen}}" class="range-details">
      <picker mode="date" value="{{rangeStart}}" end="{{rangeEnd}}" bindchange="changeRangeStart"><view><text class="small">开始</text><text>{{rangeStart}}</text></view></picker>
      <text>至</text>
      <picker mode="date" value="{{rangeEnd}}" start="{{rangeStart}}" bindchange="changeRangeEnd"><view><text class="small">结束</text><text>{{rangeEnd}}</text></view></picker>
      <view class="range-total"><text>合计 {{rangeStats.workDays}} 个工作日</text><text class="strong">{{rangeStats.duration}} 天</text></view>
    </view>
  </view>

  <view class="calendar-shell">
    <view class="week-row"><text wx:for="{{weekLabels}}" wx:key="*this" class="{{index > 4 ? 'weekend-label' : ''}}">周{{item}}</text></view>
    <view class="calendar-grid">
      <view wx:for="{{cells}}" wx:key="key" class="day-cell {{item.current ? '' : 'outside'}} {{item.selected ? 'selected' : ''}} {{item.weekend ? 'weekend' : ''}}" data-key="{{item.key}}" bindtap="selectDay">
        <view class="day-top"><text class="day-number {{item.today ? 'today' : ''}}">{{item.day}}</text><text wx:if="{{item.status}}" class="status-dot {{item.status}}"></text><text wx:if="{{item.holidayTag}}" class="holiday {{item.holidayType}}">{{item.holidayTag}}</text></view>
        <text class="lunar {{item.event ? 'event' : ''}}">{{item.calendarLabel}}</text>
        <view wx:if="{{item.planCount}}" class="plan-markers">
          <image wx:if="{{item.study}}" class="{{item.studyDone ? 'done' : ''}}" src="/assets/icons/lucide/book-open-check.svg"/>
          <image wx:if="{{item.work}}" class="{{item.workDone ? 'done' : ''}}" src="/assets/icons/lucide/briefcase-business.svg"/>
          <text wx:if="{{item.planCount > 1}}">{{item.planCount}}</text>
        </view>
        <image wx:if="{{item.noteCount}}" class="note-marker" src="/assets/icons/lucide/sticky-note.svg"/>
      </view>
    </view>
  </view>

  <view class="selected-dock" bindtap="openSelected">
    <view><text class="strong">{{selectedTitle}}</text><text>{{selectedSummary}}</text></view>
    <view><text>查看详情</text><image src="/assets/icons/lucide/chevron-right.svg"/></view>
  </view>

  <view wx:if="{{dayOpen}}" class="day-detail-mask" bindtap="closeDay"></view>
  <view class="day-detail-sheet {{dayOpen ? 'is-open' : ''}}">
    <view class="day-sheet-head">
      <view class="day-sheet-title"><text>{{daySheetTitle}}</text><view></view><text class="small">日历记录</text></view>
      <view class="day-sheet-tools"><image src="/assets/icons/doodle/plane.svg"/><view bindtap="closeDay"><image src="/assets/icons/lucide/x.svg"/></view></view>
    </view>
    <scroll-view class="day-sheet-scroll" scroll-y>
      <view class="day-status-heading"><text>当天状态</text><text>{{dayEntry.status === 'work' ? '工作日' : dayEntry.status === 'rest' ? '休息日' : dayEntry.status === 'leave' ? '请假' : '待设置'}}</text></view>
      <view class="day-status-tabs">
        <view class="{{dayEntry.status === 'work' ? 'active work' : ''}}" data-status="work" bindtap="setDayStatus"><image src="/assets/icons/lucide/briefcase-business.svg"/>工作日</view>
        <view class="{{dayEntry.status === 'rest' ? 'active rest' : ''}}" data-status="rest" bindtap="setDayStatus"><image src="/assets/icons/lucide/coffee.svg"/>休息日</view>
        <view class="{{dayEntry.status === 'leave' ? 'active leave' : ''}}" data-status="leave" bindtap="setDayStatus"><image src="/assets/icons/lucide/palmtree.svg"/>请假</view>
      </view>
      <view class="day-duration {{dayEntry.status === 'work' ? '' : 'is-muted'}}">
        <text>本日工期</text><view><view data-delta="-0.5" bindtap="adjustDayDuration"><image src="/assets/icons/lucide/minus.svg"/></view><text>{{dayEntry.status === 'work' ? (dayEntry.duration || 0) : 0}}</text><text class="small">天</text><view data-delta="0.5" bindtap="adjustDayDuration"><image src="/assets/icons/lucide/plus.svg"/></view></view>
      </view>
      <view class="day-content-tabs"><view class="{{dayTab === 'tasks' ? 'active' : ''}}" data-tab="tasks" bindtap="setDayTab"><image src="/assets/icons/lucide/book-open-check.svg"/>任务</view><view class="{{dayTab === 'notes' ? 'active' : ''}}" data-tab="notes" bindtap="setDayTab"><image src="/assets/icons/lucide/clipboard-list.svg"/>便签</view></view>

      <view wx:if="{{dayTab === 'notes'}}" class="day-content">
        <view class="day-content-head"><text>待办与便签</text><view class="day-add-note" bindtap="startDayNote"><image src="/assets/icons/lucide/plus.svg"/>新增便签</view></view>
        <view wx:if="{{dayComposeOpen}}" class="day-note-compose"><input value="{{dayNewNote}}" focus maxlength="300" placeholder="记录这一天要做的事" bindinput="inputDayNote" confirm-type="done" bindconfirm="addDayNote"/><view bindtap="addDayNote"><image src="/assets/icons/lucide/check.svg"/>保存</view></view>
        <view wx:if="{{dayNotes.length}}" class="day-note-list"><view wx:for="{{dayNotes}}" wx:key="id" class="day-note {{item.done ? 'done' : ''}}"><view data-id="{{item.id}}" bindtap="toggleDayNote">{{item.done ? '✓' : ''}}</view><text>{{item.text}}</text><image data-id="{{item.id}}" bindtap="removeDayNote" src="/assets/icons/lucide/trash-2.svg"/></view></view>
        <view wx:else class="day-empty" bindtap="startDayNote"><image src="/assets/pet/agent-focused.png" mode="aspectFit"/><view><text>今天还没有便签</text><text>把待办写下来，脑袋轻一点</text></view></view>
      </view>

      <view wx:else class="day-content">
        <view class="day-content-head"><text>规划任务</text><text>{{dayTasks.length}} 项</text></view>
        <view wx:if="{{dayTasks.length}}" class="day-task-list"><view wx:for="{{dayTasks}}" wx:key="key" class="day-task {{item.done ? 'done' : ''}}" data-plan="{{item.planId}}" data-progress="{{item.progressKey}}" bindtap="toggleDayTask"><view>{{item.done ? '✓' : ''}}</view><view><text>{{item.title}}</text><text>{{item.planTitle}}</text></view></view></view>
        <view wx:else class="day-empty"><image src="/assets/pet/agent-focused.png" mode="aspectFit"/><view><text>当天没有规划任务</text><text>可以从规划中心创建目标</text></view></view>
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{!petOpen && !petHidden}}" class="pet-quick-hide" style="left:{{petX}}px;top:{{petY}}px" catchtouchstart="stopPetEvent" catchtouchmove="stopPetEvent" catchtouchend="hidePet" catchtap="hidePet"><image src="/assets/icons/lucide/eye-off.svg"/></view>
  <view wx:if="{{!petHidden}}" class="pet-launcher mood-{{petMood}} {{petDragging ? 'is-dragging' : ''}}" data-pet-mood="{{petMood}}" style="left:{{petX}}px;top:{{petY}}px" bindtouchstart="startPetDrag" catchtouchmove="movePet" bindtouchend="endPetDrag" bindtouchcancel="endPetDrag" bindtap="togglePet">
    <view class="pet-aura"></view><text class="pet-spark one">✦</text><text class="pet-spark two">·</text><image class="pet-image" src="{{petImage}}" mode="aspectFit" fade-in="{{false}}" lazy-load="{{false}}"/><text class="pet-ai">AI</text>
  </view>
  <view wx:else class="pet-launcher pet-recall is-hidden dock-{{petDockSide}} mood-{{petMood}} {{petDragging ? 'is-dragging' : ''}}" data-pet-mood="{{petMood}}" style="left:{{petHiddenX}}px;top:{{petY}}px" bindtouchstart="startHiddenPetDrag" catchtouchmove="moveHiddenPet" bindtouchend="endHiddenPetDrag" bindtouchcancel="endHiddenPetDrag" bindtap="showPet">
    <view class="pet-aura"></view><text class="pet-spark one">✦</text><text class="pet-spark two">·</text><image class="pet-image" src="{{petImage}}" mode="aspectFit" fade-in="{{false}}" lazy-load="{{false}}"/><text class="pet-ai">AI</text>
  </view>
  <view class="pet-bubble {{bubblePlacement}} {{petOpen && !petHidden ? 'is-open' : ''}} {{bubbleResizing ? 'is-resizing' : ''}}" style="left:{{bubbleX}}px;top:{{bubbleY}}px;width:{{bubbleWidth}}px;height:{{bubbleHeight}}px;--pet-tail-x:{{bubbleTailX}}px">
    <view class="pet-drawer-header"><view class="pet-avatar mood-{{petMood}}"><text class="pet-spark one">✦</text><image src="{{petImage}}" mode="aspectFit" fade-in="{{false}}" lazy-load="{{false}}"/></view><view><text class="pet-header-title">小Y Agent</text><text class="pet-header-status">{{petBusy ? petPhase : petStatus}}</text></view><button class="pet-head-action" aria-label="隐藏宠物" catchtap="hidePet"><image src="/assets/icons/lucide/eye-off.svg"/></button><button class="pet-close" aria-label="关闭宠物对话框" catchtap="closePet"><image src="/assets/icons/lucide/x.svg"/></button></view>
    <scroll-view class="pet-scroll" scroll-y="{{true}}" enhanced="{{true}}" enable-flex="{{true}}" scroll-into-view="{{petScrollTarget}}" scroll-with-animation="{{!petBusy}}" bindscroll="onPetChatScroll" bindtouchstart="startPetScrollTouch" bindtouchend="endPetScrollTouch" bindtouchcancel="endPetScrollTouch">
      <view wx:if="{{!petMessages.length}}" class="pet-welcome"><image src="/assets/pet/agent-focused.png" mode="aspectFit"/><text class="pet-eyebrow">你的自由规划搭子</text><text class="pet-welcome-title">你说目标，小Y 来拆步骤、查资料、排时间</text><text>我会先看你的日历和已有规划；方案只有在你确认后才会写入。</text><view class="quick-list"><view class="quick-prompt" wx:for="{{quickPrompts}}" wx:key="*this" data-prompt="{{item}}" bindtap="sendPet">{{item}}</view></view></view>
      <view wx:else class="pet-messages">
        <view wx:for="{{petMessages}}" wx:key="id" wx:for-item="message" class="pet-message {{message.role}} {{message.streaming ? 'is-streaming' : ''}}">
          <view class="pet-rich-text">
            <view wx:for="{{message.blocks}}" wx:key="id" wx:for-item="block" class="pet-rich-row {{block.type}} level-{{block.level}}">
              <text wx:if="{{block.marker}}" class="pet-rich-marker">{{block.marker}}</text>
              <text wx:for="{{block.segments}}" wx:key="index" wx:for-item="segment" class="{{segment.strong ? 'is-strong' : ''}}">{{segment.text}}</text>
            </view>
            <text wx:if="{{message.streaming}}" class="pet-stream-caret"> </text>
          </view>
        </view>
      </view>
      <view wx:if="{{petError}}" class="pet-error">{{petError}}</view>
      <view wx:if="{{petResult.questions.length}}" class="pet-followups"><text>还差一点信息</text><text class="pet-followup-hint">点一个问题填入输入框</text><view class="pet-question" wx:for="{{petResult.questions}}" wx:key="*this" data-prompt="{{item}}" bindtap="choosePetQuestion">{{item}}</view></view>
      <view wx:if="{{petResult.actionDrafts.length}}" class="pet-actions"><text class="pet-section-heading">主题操作</text><view class="pet-action-card" wx:for="{{petResult.actionDrafts}}" wx:key="id"><view><text class="pet-action-title">{{item.label}}</text><text class="pet-action-description">{{item.description}}</text></view><button class="pet-action-button {{item.applied ? 'is-disabled' : ''}}" disabled="{{item.applied}}" data-id="{{item.id}}" bindtap="applyPetThemeAction">{{item.applied ? '已完成' : '确认执行'}}</button></view></view>
      <view wx:if="{{petResult.planDrafts.length}}" class="pet-plans"><text class="pet-section-heading">建议规划</text><view class="pet-plan-card" wx:for="{{petResult.planDrafts}}" wx:key="title"><text class="pet-plan-title">{{item.title}}</text><text>{{item.dailyTask}}</text><text>{{item.start}} 至 {{item.end}}</text></view><view class="apply-plans {{petApplied ? 'is-disabled' : ''}}" bindtap="applyPetPlans">{{petApplied ? '已写入规划中心' : '确认并写入规划中心'}}</view></view>
      <view id="pet-chat-end-0" class="pet-chat-anchor"></view><view id="pet-chat-end-1" class="pet-chat-anchor"></view>
    </scroll-view>
    <view class="pet-composer"><textarea value="{{petInput}}" focus="{{petInputFocus}}" maxlength="1200" placeholder="告诉小Y你的目标…" bindinput="inputPet" bindblur="blurPetInput"/><view class="pet-send {{petBusy ? 'is-disabled' : ''}}" bindtap="sendPet"><image src="/assets/icons/lucide/arrow-right.svg"/></view></view>
    <button class="pet-resize-handle" aria-label="拖动或点击调整宠物对话框大小" catchtap="cycleBubbleSize" catchtouchstart="startBubbleResize" catchtouchmove="resizeBubble" catchtouchend="endBubbleResize" catchtouchcancel="endBubbleResize"><image src="/assets/icons/lucide/move-diagonal-2.svg"/></button>
  </view>
</view>
