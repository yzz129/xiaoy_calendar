.profile-page{background:linear-gradient(180deg,#f4fbff,#fffdf8)}.profile-hero{padding:28rpx;display:grid;grid-template-columns:120rpx 1fr;align-items:center;gap:20rpx}.profile-hero image{width:112rpx;height:112rpx;border-radius:30rpx}.profile-hero>view{display:flex;flex-direction:column}.profile-hero text{color:var(--mint-dark);font-size:18rpx;font-weight:900}.profile-hero .strong{font-family:"XY Doodle",sans-serif;font-size:38rpx}.profile-hero .small{color:var(--muted);font-size:17rpx}.admin-entry{margin-top:24rpx;padding:22rpx;display:grid;grid-template-columns:66rpx 1fr 28rpx;align-items:center;gap:15rpx;border:2rpx solid var(--ink);border-radius:27rpx 22rpx 30rpx 19rpx;background:var(--mint-soft);box-shadow:6rpx 7rpx 0 var(--mint)}.admin-entry>image:first-child{width:42rpx;height:42rpx;padding:11rpx;border-radius:18rpx;background:#fff}.admin-entry>image:last-child{width:27rpx;height:27rpx}.admin-entry>view{display:flex;flex-direction:column}.admin-entry .strong{font-size:25rpx}.admin-entry text{color:var(--text);font-size:16rpx}.profile-form{margin-top:24rpx;padding:28rpx}.profile-form>.strong{font-size:28rpx}.save{margin-top:30rpx}.disabled{opacity:.55}.menu{margin-top:24rpx;overflow:hidden}.menu>view{min-height:84rpx;padding:0 22rpx;display:grid;grid-template-columns:34rpx 1fr 28rpx;align-items:center;gap:13rpx}.menu>view+view{border-top:2rpx solid var(--line)}.menu image{width:28rpx;height:28rpx}.menu .logout{grid-template-columns:34rpx 1fr;color:#d95f52;background:var(--coral-soft)}
