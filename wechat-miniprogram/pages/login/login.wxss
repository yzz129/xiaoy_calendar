.login-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 70rpx 36rpx;
  display: flex;
  align-items: center;
  background: radial-gradient(circle at 50% 0%, #dcfff3 0, #f4fbff 52%, #fffaf1 100%);
}

.login-card {
  box-sizing: border-box;
  width: 100%;
  padding: 50rpx 42rpx 38rpx;
}

.brand-icon {
  width: 150rpx;
  height: 150rpx;
  margin: 0 auto;
  display: block;
  border-radius: 38rpx;
}

.brand-name {
  margin-top: 24rpx;
  text-align: center;
  font-size: 52rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.brand-copy {
  margin-top: 10rpx;
  color: #7f95a9;
  text-align: center;
  font-size: 26rpx;
}

.mode-tabs {
  margin-top: 40rpx;
  padding: 8rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8rpx;
  border-radius: 26rpx;
  background: #edf4f8;
}

.mode-tab {
  min-height: 74rpx;
  border-radius: 20rpx;
  background: transparent;
  color: #7890a4;
  font-weight: 700;
}

.mode-tab.active {
  background: #fff;
  color: #153454;
  box-shadow: 0 4rpx 12rpx rgba(21, 52, 84, 0.08);
}

.password-switch {
  padding: 18rpx 0 0;
  background: transparent;
  color: #66829b;
  text-align: right;
  font-size: 24rpx;
  line-height: 1;
}

.form-error {
  margin-top: 22rpx;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  background: #fff0ee;
  color: #d95e50;
  font-size: 25rpx;
}

.submit-button {
  margin-top: 32rpx;
}

.privacy-link {
  padding-top: 28rpx;
  color: #7890a4;
  text-align: center;
  font-size: 24rpx;
}
