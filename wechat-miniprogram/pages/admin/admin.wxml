<view class="admin-page">
  <view class="admin-header"><view class="admin-brand"><image src="/assets/icons/doodle/mascot.svg"/><view><text>小Y日历</text><view></view></view></view><view class="admin-title"><image src="/assets/icons/lucide/shield-check.svg"/><text>管理员后台</text></view><view class="admin-nav"><view bindtap="back"><image src="/assets/icons/lucide/arrow-left.svg"/></view><view bindtap="logout"><image src="/assets/icons/lucide/log-out.svg"/></view></view></view>
  <view class="summary-grid"><view><image src="/assets/icons/lucide/users-round.svg"/><text>全部用户</text><text class="strong">{{summary.users}}</text></view><view><image src="/assets/icons/lucide/shield-check.svg"/><text>正常账号</text><text class="strong">{{summary.active}}</text></view><view><image src="/assets/icons/lucide/message-circle.svg"/><text>聊天消息</text><text class="strong">{{summary.chats}}</text></view><view><image src="/assets/icons/lucide/bot.svg"/><text>AI 调用</text><text class="strong">{{summary.calls}}</text></view></view>
  <view class="users-card">
    <view class="users-heading"><view><text class="strong">全部用户</text><text>共 {{summary.users}} 位 · 当前管理员：{{detail ? detail.user.nickname : 'yzz'}}</text></view><view class="add-user" bindtap="openCreate"><image src="/assets/icons/lucide/plus.svg"/>新增</view></view>
    <view class="filters"><view class="search"><image src="/assets/icons/lucide/search.svg"/><input value="{{search}}" placeholder="搜索昵称" confirm-type="search" bindinput="inputSearch" bindconfirm="submitSearch"/><view bindtap="submitSearch"><image src="/assets/icons/lucide/refresh-cw.svg"/></view></view><picker range="{{sorts}}" range-key="label" value="{{sortIndex}}" bindchange="changeSort"><view class="sort"><image src="/assets/icons/lucide/arrow-down-up.svg"/>{{sorts[sortIndex].label}}<image src="/assets/icons/lucide/chevron-down.svg"/></view></picker></view>
    <view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{loading}}" class="loading">正在同步后台数据…</view>
    <view wx:else class="user-list"><view wx:for="{{users}}" wx:key="id" class="user-row" data-id="{{item.id}}" bindtap="openDetail"><view class="avatar {{item.role}}">{{item.initial}}</view><view class="user-main"><view><text class="strong">{{item.nickname}}</text><text wx:if="{{item.role === 'admin'}}">管理员</text></view><text>{{item.statusLabel}} · 最近活跃 {{item.lastActiveLabel}}</text><view><text>{{item.plan_count}} 规划</text><text>{{item.model_call_count}} AI</text><text>{{item.activity_count}} 行为</text></view></view><image src="/assets/icons/lucide/chevron-right.svg"/></view><view wx:if="{{!users.length}}" class="loading">没有匹配用户</view></view>
  </view>

  <view wx:if="{{detailOpen}}" class="modal-mask" bindtap="closeDetail"></view>
  <view class="detail-sheet {{detailOpen ? 'open' : ''}}">
    <view class="sheet-header"><view><text class="strong">{{detail ? detail.user.nickname : '用户详情'}}</text><text>{{detail ? detail.user.roleLabel + ' · ' + detail.user.statusLabel : ''}}</text></view><view class="sheet-actions"><view wx:if="{{detail}}" bindtap="openEdit"><image src="/assets/icons/lucide/pencil.svg"/></view><view bindtap="closeDetail"><image src="/assets/icons/lucide/x.svg"/></view></view></view>
    <scroll-view scroll-x class="tabs"><view wx:for="{{tabs}}" wx:key="value" class="{{activeTab === item.value ? 'active' : ''}}" data-tab="{{item.value}}" bindtap="switchTab">{{item.label}}</view></scroll-view>
    <scroll-view scroll-y class="detail-scroll"><view wx:if="{{detailLoading}}" class="loading">加载用户详情…</view>
      <block wx:if="{{detail}}">
        <view wx:if="{{activeTab === 'overview'}}" class="detail-section"><view class="detail-stats"><view><text>注册时间</text><text class="strong">{{detail.user.createdLabel}}</text></view><view><text>快照更新</text><text class="strong">{{detail.snapshotUpdatedLabel}}</text></view><view><text>会话</text><text class="strong">{{detail.usage.session_count || 0}}</text></view><view><text>行为</text><text class="strong">{{detail.usage.activity_count || 0}}</text></view></view><view class="danger" bindtap="deleteUser"><image src="/assets/icons/lucide/trash-2.svg"/>删除此用户及全部数据</view></view>
        <view wx:if="{{activeTab === 'plans'}}" class="detail-section"><view wx:for="{{detailPlans}}" wx:key="id" class="record"><text class="strong">{{item.title}}</text><text>{{item.dailyTask}}</text><text>{{item.start}} 至 {{item.end}}</text></view><view wx:if="{{!detailPlans.length}}" class="loading">暂无规划</view></view>
        <view wx:if="{{activeTab === 'usage'}}" class="detail-section"><view class="detail-stats"><view><text>聊天</text><text class="strong">{{detail.usage.chat_count || 0}}</text></view><view><text>调用</text><text class="strong">{{detail.usage.call_count || 0}}</text></view><view><text>成功</text><text class="strong">{{detail.usage.successful_calls || 0}}</text></view><view><text>平均延迟</text><text class="strong">{{detail.usage.average_latency_ms || 0}} ms</text></view></view></view>
        <view wx:if="{{activeTab === 'chats'}}" class="detail-section"><view wx:for="{{detail.chats}}" wx:key="id" class="record"><text class="strong">{{item.role}} · {{item.timeLabel}}</text><text>{{item.content}}</text></view><view wx:if="{{!detail.chats.length}}" class="loading">暂无聊天记录</view></view>
        <view wx:if="{{activeTab === 'calls'}}" class="detail-section"><view wx:for="{{detail.modelCalls}}" wx:key="id" class="record"><text class="strong">{{item.provider}} / {{item.model}}</text><text>{{item.status}} · {{item.latency_ms}} ms · {{item.timeLabel}}</text><text>{{item.request_preview}}</text></view><view wx:if="{{!detail.modelCalls.length}}" class="loading">暂无 AI 调用</view></view>
        <view wx:if="{{activeTab === 'activity'}}" class="detail-section"><view wx:for="{{detail.activities}}" wx:key="id" class="record"><text class="strong">{{item.action}} · {{item.timeLabel}}</text><text>网络出口位置（IP 推断）：{{item.location || '旧记录未采集'}}</text><text>{{item.ip}}</text></view><view wx:if="{{!detail.activities.length}}" class="loading">暂无用户行为</view></view>
      </block>
    </scroll-view>
  </view>

  <view wx:if="{{createOpen}}" class="form-mask"><view class="form-card"><text class="strong">新增用户</text><input placeholder="昵称" data-field="nickname" bindinput="inputCreate"/><input password placeholder="密码（6—72 位）" data-field="password" bindinput="inputCreate"/><view class="switch-row"><text>设为管理员</text><switch color="#20b88a" bindchange="changeCreateRole"/></view><view class="form-actions"><view bindtap="closeCreate">取消</view><view class="save" bindtap="createUser">创建</view></view></view></view>
  <view wx:if="{{editOpen}}" class="form-mask"><view class="form-card"><text class="strong">编辑用户</text><input value="{{editForm.nickname}}" placeholder="昵称" data-field="nickname" bindinput="inputEdit"/><input password placeholder="留空则不修改密码" data-field="password" bindinput="inputEdit"/><view class="switch-row"><text>管理员</text><switch checked="{{editForm.role === 'admin'}}" color="#20b88a" bindchange="changeEditRole"/></view><view class="switch-row"><text>账号正常</text><switch checked="{{editForm.status === 'active'}}" color="#20b88a" bindchange="changeEditStatus"/></view><view class="form-actions"><view bindtap="closeEdit">取消</view><view class="save" bindtap="saveUser">保存</view></view></view></view>
</view>
