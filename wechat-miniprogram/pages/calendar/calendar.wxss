.pet-launcher{width:112rpx;height:112rpx;position:fixed;z-index:92;display:flex;align-items:center;justify-content:center;touch-action:none;transition:left .2s ease,transform .12s;cursor:grab}.pet-launcher.is-dragging{transform:scale(1.06);transition:none;cursor:grabbing}.pet-launcher.is-hidden{z-index:110;transition:left .2s ease,top .08s linear,transform .12s}.pet-launcher>image{width:105rpx;height:105rpx;position:relative;z-index:2;object-fit:contain;transform-origin:50% 82%;filter:drop-shadow(0 8rpx 6rpx rgba(22,50,79,.2));pointer-events:none;animation:petBreathe 3.2s ease-in-out infinite}.pet-launcher.mood-focused>image{animation:petWork 2.4s ease-in-out infinite}.pet-launcher.mood-thinking>image{animation:petThink 2.8s ease-in-out infinite}.pet-launcher.mood-celebrate>image{animation:petCelebrate .82s cubic-bezier(.2,.8,.2,1) infinite}.pet-launcher.mood-sleepy>image{animation:petSleep 4.6s ease-in-out infinite}.pet-launcher.is-hidden>image{animation:petPeek 3.2s ease-in-out infinite}.pet-launcher.is-dragging>image{animation:petDragged .5s ease-in-out infinite alternate}.pet-recall{cursor:grab}.pet-recall.is-dragging{cursor:grabbing}.pet-aura{position:absolute;inset:12rpx;border-radius:50%;background:rgba(121,221,189,.3);box-shadow:0 0 0 9rpx rgba(121,221,189,.1);pointer-events:none;animation:petPulse 2.8s ease-in-out infinite}.pet-spark{width:12rpx;height:12rpx;position:absolute;z-index:3;border-radius:4rpx 12rpx 4rpx 12rpx;background:var(--coral);pointer-events:none;animation:petSpark 1.6s ease-in-out infinite}.pet-spark.one{right:4rpx;top:25rpx}.pet-spark.two{right:15rpx;top:7rpx;background:var(--yellow);animation-delay:.55s}.pet-ai{position:absolute;z-index:3;right:0;bottom:8rpx;padding:2rpx 8rpx;border-radius:11rpx;background:var(--yellow);font-size:14rpx;font-weight:900;pointer-events:none}.pet-quick-hide{width:38rpx;height:38rpx;position:fixed;z-index:120;box-sizing:border-box;display:flex;align-items:center;justify-content:center;border:2rpx solid var(-