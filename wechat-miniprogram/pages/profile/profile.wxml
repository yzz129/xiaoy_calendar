<view class="page-shell profile-page"><view class="profile-hero card"><image src="/assets/app-icon.png"/><view><text>个人中心</text><text class="strong">{{user.nickname}}</text><text class="small">{{isAdmin ? '管理员账号' : '普通账号'}} · 云端同步已开启</text></view></view>
  <view wx:if="{{isAdmin}}" class="admin-entry" bindtap="openAdmin"><image src="/assets/icons/lucide/shield-check.svg"/><view><text class="strong">管理员后台</text><text>用户、规划、AI 调用与行为数据</text></view><image src="/assets/icons/lucide/chevron-right.svg"/></view>
  <view class="profile-form card"><text class="strong">修改个人资料</text><label class="field"><text class="field-label">昵称</text><input class="input" value="{{form.nickname}}" data-field="nickname" bindinput="inputField"/></label><label class="field"><text class="field-label">当前密码</text><input class="input" password placeholder="修改密码时必填" data-field="currentPassword" bindinput="inputField"/></label><label class="field"><text class="field-label">新密码</text><input class="input" password placeholder="留空则不修改" data-field="newPassword" bindinput="inputField"/></label><view class="primary-button save {{saving ? 'disabled' : ''}}" bindtap="saveProfile">{{saving ? '正在保存…' : '保存资料'}}</view></view>
  <view class="menu card"><view bindtap="openPrivacy"><image src="/assets/icons/lucide/shield-check.svg"/><text>隐私保护说明 · 微信小程序 2.1.8</text><image src="/assets/icons/lucide/chevron-right.svg"/></view><view class="logout" bindtap="logout"><image src="/assets/icons/lucide/log-out.svg"/><text>退出登录</text></view></view>
</view>
