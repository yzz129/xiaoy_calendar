<view class="page-shell plans-page theme-{{theme}} {{fontClass}} {{skinClass}}" style="{{skinStyle}}">
  <view class="intro-card card">
    <text>规划中心</text>
    <text class="intro-copy">创建一个目标，小Y会把每日任务显示在对应日期中。</text>
  </view>

  <view class="create-card card">
    <view class="section-title">新建规划</view>
    <view class="type-row"><view class="{{form.type === 'study' ? 'active' : ''}}" data-type="study" bindtap="setType"><image src="/assets/icons/lucide/book-open-check.svg"/>学习规划</view><view class="{{form.type === 'work' ? 'active' : ''}}" data-type="work" bindtap="setType"><image src="/assets/icons/lucide/briefcase-business.svg"/>工作规划</view></view>
    <label class="field"><text class="field-label">规划名称</text><input class="input" value="{{form.title}}" maxlength="40" placeholder="{{form.type === 'study' ? '例如：30 天英语学习' : '例如：完成作品集改版'}}" placeholder-class="xy-placeholder" data-field="title" bindinput="inputField" /></label>
    <label class="field"><text class="field-label">每日任务</text><input class="input" value="{{form.dailyTask}}" maxlength="80" placeholder="{{form.type === 'study' ? '例如：背 20 个单词' : '例如：完成一个页面'}}" placeholder-class="xy-placeholder" data-field="dailyTask" bindinput="inputField" /></label>
    <view class="date-row">
      <label class="field"><text class="field-label">开始日期</text><picker mode="date" value="{{form.start}}" bindchange="setStart"><view class="picker-value">{{form.start}}</view></picker></label>
      <label class="field"><text class="field-label">结束日期</text><picker mode="date" value="{{form.end}}" bindchange="setEnd"><view class="picker-value">{{form.end}}</view></picker></label>
    </view>
    <view class="field">
      <text class="field-label">执行日</text>
      <view class="weekday-row">
        <view wx:for="{{weekdays}}" wx:key="value" class="weekday-button {{item.active ? 'active' : ''}}" data-value="{{item.value}}" bindtap="toggleWeekday">{{item.label}}</view>
      </view>
    </view>
    <view class="primary-button create-button {{!form.title || !form.dailyTask ? 'disabled' : ''}}" bindtap="createPlan">保存规划</view>
  </view>

  <view class="plan-list">
    <view wx:for="{{plans}}" wx:key="id" class="plan-card card">
      <view class="plan-head"><view><text>{{item.title}}</text><text class="plan-range">{{item.start}} 至 {{item.end}}</text></view><text class="plan-type">{{item.typeLabel}}</text></view>
      <view class="daily-task">每天：{{item.dailyTask}}</view>
      <view class="progress"><view style="width: {{item.percent}}%"></view></view>
      <view class="plan-foot"><text>已完成 {{item.completed}} / {{item.total}}</text><view data-id="{{item.id}}" bindtap="removePlan">删除</view></view>
    </view>
    <view wx:if="{{!plans.length}}" class="empty-state card">还没有规划，先创建一个吧</view>
  </view>
</view>
