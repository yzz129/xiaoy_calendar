.adaptive-palette{display:grid;grid-template-columns:30rpx 30rpx 30rpx minmax(0,1fr);align-items:center;gap:8rpx;padding:11rpx 14rpx;border:2rpx solid var(--line);border-radius:16rpx;background:var(--paper-soft)}
.adaptive-palette view{width:30rpx;height:30rpx;border:2rpx solid var(--line);border-radius:10rpx 8rpx 11rpx 7rpx}
.adaptive-palette text{min-width:0;color:var(--mint-dark);font-size:18rpx;font-weight:900}
.skin-preview.has-image{min-height:0;align-self:start;background:rgba(255,255,255,.18)}
.skin-preview-image{display:block;width:100%;height:auto}
.theme-page{padding-bottom:70rpx;background-color:#f8fcfb}.theme-page.theme-berry-night{background-color:#0b1d31}.theme-hero{display:grid;grid-template-columns:88rpx 1fr;align-items:center;gap:20rpx;padding:28rpx}.theme-mark{width:84rpx;height:84rpx;display:flex;align-items:center;justify-content:center;border-radius:28rpx 22rpx 30rpx 20rpx;background:var(--mint-soft);color:var(--mint-dark);font-size:38rpx}.theme-hero>view:last-child,.section-heading,.theme-option,.upload-copy{display:flex;flex-direction:column}.theme-title{font-family:"XY Doodle","XY Rounded",sans-serif;font-size:42rpx;font-weight:900}.theme-subtitle,.section-heading text:last-child,.option-note,.upload-copy text:last-child,.upload-help{color:var(--muted)}.theme-subtitle{margin-top:8rpx;font-size:23rpx;line-height:1.55}.theme-section{margin-top:24rpx;padding:28rpx}.section-heading text:first-child{font-size:31rpx;font-weight:900}.section-heading text:last-child{margin-top:6rpx;font-size:22rpx}.option-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:22rpx}.theme-option{position:relative;min-height:142rpx;box-sizing:border-box;align-items:flex-start;justify-content:center;padding:32rpx 24rpx 22rpx;border:2rpx solid var(--line);border-radius:28rpx 22rpx 30rpx 20rpx;background:var(--paper);color:var(--ink);text-align:left}.theme-option.selected{border:4rpx solid var(--mint-dark);box-shadow:6rpx 7rpx 0 var(--mint-soft)}.option-name{font-size:29rpx;font-weight:900}.option-note{margin-top:8rpx;font-size:20rpx;line-height:1.4}.system-preview,.system-preview text{font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif}.current-badge,.custom-current{position:absolute;top:12rpx;right:12rpx;z-index:2;padding:6rpx 10rpx;border-radius:999rpx;background:var(--mint-soft);color:var(--mint-dark);font-size:17rpx;font-weight:900}.skin-option{min-height:150rpx;display:grid;grid-template-columns:88rpx 1fr;align-items:center;gap:16rpx;padding-left:16rpx}.skin-option>view:nth-child(2){min-width:0;display:flex;flex-direction:column;align-items:flex-start}.skin-swatch{width:86rpx;height:70rpx;position:relative;overflow:hidden;border:2rpx solid var(--line);border-radius:22rpx 17rpx 24rpx 15rpx;background:#fff}.skin-swatch text:first-child{width:48rpx;height:48rpx;position:absolute;left:9rpx;bottom:-10rpx;border-radius:50%;background:#79ddbd}.skin-swatch text:last-child{width:30rpx;height:30rpx;position:absolute;top:8rpx;right:8rpx;border-radius:10rpx;background:#ffd968}.night-swatch{background:#0e2239}.night-swatch text:first-child{background:#57a9e8}.night-swatch text:last-child{background:#ff806d}.upload-panel{display:grid;position:relative;grid-template-columns:210rpx 1fr;gap:16rpx 20rpx;margin-top:22rpx;padding:18rpx;border:2rpx dashed var(--line);border-radius:28rpx 22rpx 30rpx 20rpx;background:var(--paper)}.upload-panel.active{border-style:solid;border-color:var(--mint-dark)}.skin-preview{min-height:226rpx;grid-row:1/5;position:relative;overflow:hidden;border-radius:22rpx 17rpx 24rpx 15rpx;background-color:var(--blue-soft)}.skin-preview>view{width:100%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--muted);font-size:21rpx}.preview-icon{margin-bottom:10rpx;font-size:42rpx}.crop-badge{position:absolute;right:10rpx;bottom:10rpx;padding:8rpx 11rpx;border-radius:12rpx;background:rgba(255,217,104,.92);color:#725600;font-size:17rpx;font-weight:900}.upload-copy{justify-content:flex-end}.upload-copy text:first-child{font-size:28rpx;font-weight:900}.upload-copy text:last-child{margin-top:7rpx;font-size:20rpx;line-height:1.5}.upload-button,.remove-button{min-height:76rpx;border-radius:22rpx;font-size:22rpx;font-weight:900}.upload-button{background:var(--mint);color:var(--ink);box-shadow:5rpx 5rpx 0 var(--ink)}.remove-button{background:var(--coral-soft);color:var(--coral)}.upload-help{font-size:18rpx;line-height:1.55}.theme-status{margin-top:18rpx;padding:18rpx 20rpx;border-radius:18rpx;background:var(--mint-soft);color:var(--mint-dark);font-size:21rpx;line-height:1.5}@media(max-width:360px){.option-grid{grid-template-columns:1fr}.upload-panel{grid-template-columns:170rpx 1fr}}
