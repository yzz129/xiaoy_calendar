page {
  --paper: #ffffff;
  --paper-soft: #fbfdfc;
  --ink: #16324f;
  --text: #536b80;
  --muted: #91a2b1;
  --line: #dce7ee;
  --mint: #79ddbd;
  --mint-dark: #20b88a;
  --mint-soft: #e8f8f2;
  --coral: #ff806d;
  --coral-soft: #fff0ed;
  --blue-soft: #edf7ff;
  --yellow: #ffd968;
  min-height: 100%;
  background: #f8fcfb;
  color: var(--ink);
  font-family: "XY Rounded", "XY Rounded Full", "Microsoft YaHei", "PingFang SC", sans-serif;
}

button {
  margin: 0;
  font: inherit;
}

input,
textarea {
  font-family: "XY Rounded", "XY Rounded Full", "Microsoft YaHei", "PingFang SC", sans-serif;
}

.xy-placeholder {
  color: var(--muted);
  font-family: "XY Rounded", "XY Rounded Full", "Microsoft YaHei", "PingFang SC", sans-serif;
}

button::after {
  border: 0;
}

.page-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 20rpx;
}

.card {
  background: var(--paper);
  border: 2rpx solid var(--line);
  border-radius: 30rpx 24rpx 34rpx 22rpx;
  box-shadow: 10rpx 12rpx 0 rgba(220, 231, 238, 0.8);
}

.primary-button,
.secondary-button,
.danger-button {
  min-height: 88rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
}

.primary-button {
  background: var(--mint);
  color: var(--ink);
  border: 2rpx solid var(--ink);
  box-shadow: 6rpx 7rpx 0 var(--ink);
}

.secondary-button {
  background: var(--blue-soft);
  color: var(--ink);
}

.danger-button {
  background: #fff0ee;
  color: #e66c5f;
}

.field {
  display: block;
  margin-top: 28rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: #587087;
  font-size: 26rpx;
  font-weight: 700;
}

.input {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  padding: 0 28rpx;
  border: 2rpx solid var(--line);
  border-radius: 24rpx;
  background: #fff;
  color: var(--ink);
}

.empty-state {
  padding: 64rpx 30rpx;
  color: var(--muted);
  text-align: center;
}
