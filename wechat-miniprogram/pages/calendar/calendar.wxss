.pet-bubble{position:fixed;z-index:91;min-height:0;box-sizing:border-box;display:grid;grid-template-rows:auto minmax(0,1fr) auto;overflow:visible;border:0;border-radius:28rpx 24rpx 31rpx 22rpx;background:var(--paper);box-shadow:0 18rpx 52rpx rgba(12,41,79,.22),7rpx 8rpx 0 rgba(220,231,238,.8);opacity:0;pointer-events:none;transform:translateY(8rpx) scale(.92);transition:opacity .18s,transform .22s cubic-bezier(.2,.8,.2,1),left .08s linear,top .08s linear}.pet-bubble.is-open{opacity:1;pointer-events:auto;transform:translateY(0) scale(1)}.pet-bubble.is-resizing{transition:none;user-select:none}.pet-bubble::after{content:"";width:22rpx;height:22rpx;position:absolute;z-index:0;left:calc(var(--pet-tail-x) - 11rpx);background:var(--paper);border-radius:4rpx;box-shadow:5rpx 5rpx 9rpx rgba(12,41,79,.06);transform:rotate(45deg)}.pet-bubble.above{transform-origin:var(--pet-tail-x) calc(100% + 12rpx)}.pet-bubble.above::after{bottom:-8rpx}.pet-bubble.below{transform-origin:var(--pet-tail-x) -12rpx}.pet-bubble.below::after{top:-8rpx}.pet-bubble>.pet-drawer-header,.pet-bubble>.pet-scroll,.pet-bubble>.pet-composer{position:relative;z-index:1}
.pet-drawer-header{min-height:76rpx;box-sizing:border-box;padding:10rpx 12rpx;display:grid;grid-template-columns:54rpx minmax(0,1fr) 48rpx 48rpx;align-items:center;gap:7rpx;border-bottom:2rpx solid var(--line);border-radius:28rpx 24rpx 0 0;background:var(--mint-soft)}.pet-avatar{position:relative}.pet-avatar,.pet-avatar image{width:52rpx;height:52rpx}.pet-avatar image{object-fit:contain;transform-origin:50% 82%;animation:petBreathe 3.2s ease-in-out infinite}.pet-avatar.mood-focused image{animation:petWork 2.4s ease-in-out infinite}.pet-avatar.mood-thinking image{animation:petThink 2.8s ease-in-out infinite}.pet-avatar.mood-celebrate image{animation:petCelebrate .82s cubic-bezier(.2,.8,.2,1) infinite}.pet-avatar.mood-sleepy image{animation:petSleep 4.6s ease-in-out infinite}.pet-avatar .pet-spark{width:8rpx;height:8rpx}.pet-avatar .pet-spark.one{right:-2rpx;top:10rpx}.pet-avatar .pet-spark.two{right:6rpx;top:-1rpx}.pet-drawer-header>view:nth-child(2){min-width:0;display:flex;flex-direction:column}.pet-header-title{font-family:"XY Doodle","XY Rounded","YouYuan",sans-serif;font-size:23rpx}.pet-header-status{color:var(--text);font-size:13rpx}.pet-head-action,.pet-close{width:46rpx;height:46rpx;border:2rpx solid var(--line);border-radius:15rpx;background:var(--paper);display:flex;align-items:center;justify-content:center}.pet-head-action image,.pet-close image{width:24rpx;height:24rpx}
.pet-scroll{width:100%;height:100%;min-height:0;box-sizing:border-box;overflow:hidden;padding:14rpx;background:var(--paper);border-radius:0;overscroll-behavior:contain;touch-action:pan-y;-webkit-overflow-scrolling:touch}.pet-welcome{display:flex;flex-direction:column;align-items:center;text-align:center}.pet-welcome>image{width:110rpx;height:96rpx}.pet-eyebrow{color:var(--mint-dark);font-size:15rpx;font-weight:900;letter-spacing:2rpx}.pet-welcome-title{margin:7rpx 0;font-family:"XY Doodle","XY Rounded","YouYuan",sans-serif;font-size:25rpx}.pet-welcome>text:last-of-type{color:var(--text);font-size:15rpx;line-height:1.55}.quick-list{width:100%;margin-top:12rpx;display:grid;gap:7rpx}.quick-prompt,.pet-question{padding:11rpx 13rpx;border:2rpx solid var(--line);border-radius:15rpx;background:var(--paper-soft);font-size:16rpx;text-align:left}.pet-messages{min-height:0;display:flex;flex-direction:column;gap:9rpx}.pet-message{max-width:88%;padding:20rpx 24rpx;border:2rpx solid var(--line);border-radius:28rpx 28rpx 28rpx 10rpx;background:var(--paper-soft);color:var(--ink);font-family:"XY Rounded","YouYuan","Microsoft YaHei",sans-serif;font-size:22rpx;font-weight:700;line-height:1.7}.pet-message.user{align-self:flex-end;border-color:var(--mint);border-radius:28rpx 28rpx 10rpx 28rpx;background:var(--mint-soft)}.pet-rich-text{min-width:0;display:grid;gap:10rpx}.pet-rich-row{display:block;max-width:100%;line-height:1.7;white-space:pre-wrap;word-break:break-word}.pet-rich-row.gap{height:10rpx}.pet-rich-row.heading{font-size:1.08em;font-weight:950}.pet-rich-row.step,.pet-rich-row.bullet{padding-left:2rpx}.pet-rich-marker{margin-right:8rpx;color:var(--mint-dark);font-weight:950}.pet-rich-row .is-strong{color:var(--ink);font-weight:950}.pet-message.user .is-strong{color:var(--mint-dark)}.pet-stream-caret{width:3rpx;height:1.05em;display:inline-block;margin-left:4rpx;background:var(--mint-dark);vertical-align:-.12em;animation:petCaret 1s steps(1) infinite}.pet-chat-anchor{height:1rpx}.pet-thinking,.pet-error{margin-top:10rpx;padding:11rpx;color:var(--text);font-size:15rpx}.pet-error{background:var(--coral-soft);color:#bd493a}.pet-followups,.pet-plans{margin-top:12rpx;padding:13rpx;display:grid;gap:7rpx;border:2rpx dashed var(--line);border-radius:17rpx;background:var(--paper)}.pet-section-heading,.pet-followups>text{font-size:18rpx;font-weight:900}.pet-followups>.pet-followup-hint{color:var(--muted);font-size:13rpx;font-weight:700}.pet-plan-card{padding:11rpx;display:flex;flex-direction:column;gap:4rpx;border-radius:13rpx;background:var(--blue-soft);font-size:14rpx}.pet-plan-title{font-size:17rpx;font-weight:900}.apply-plans{min-height:55rpx;border:2rpx solid var(--ink);border-radius:15rpx;background:var(--mint);display:flex;align-items:center;justify-content:center;font-size:15rpx;font-weight:900}.apply-plans.is-disabled{opacity:.55}
.pet-composer{box-sizing:border-box;padding:10rpx 12rpx 14rpx;display:grid;grid-template-columns:minmax(0,1fr) 52rpx;gap:7rpx;border-top:2rpx solid var(--line);border-radius:0 0 31rpx 22rpx;background:var(--paper)}.pet-composer textarea{width:100%;min-height:54rpx;max-height:96rpx;box-sizing:border-box;padding:10rpx 12rpx;border:2rpx solid var(--line);border-radius:15rpx;background:var(--paper-soft);font-size:15rpx}.pet-send{width:52rpx;height:52rpx;border:2rpx solid var(--ink);border-radius:15rpx;background:var(--mint);display:flex;align-items:center;justify-content:center}.pet-send image{width:24rpx;height:24rpx}.pet-send.is-disabled{opacity:.45}.pet-resize-handle{width:42rpx;height:42rpx;position:absolute;z-index:5;right:-3rpx;bottom:-3rpx;display:flex;align-items:center;justify-content:center;border-radius:15rpx 0 22rpx 0;background:var(--mint-soft);touch-action:none}.pet-resize-handle image{width:25rpx;height:25rpx}
@keyframes petBreathe{0%,100%{transform:translateY(2rpx) scale(.98)}50%{transform:translateY(-6rpx) scale(1.03)}}
@keyframes petWork{0%,100%{transform:translateY(2rpx) rotate(-1.5deg)}45%{transform:translateY(-6rpx) rotate(1.5deg)}60%{transform:translateY(-4rpx) rotate(.3deg)}}
@keyframes petThink{0%,100%{transform:translateY(2rpx) rotate(-3deg)}50%{transform:translateY(-8rpx) rotate(3deg)}}
@keyframes petCelebrate{0%,100%{transform:translateY(4rpx) scale(.96) rotate(-2deg)}48%{transform:translateY(-16rpx) scale(1.05) rotate(2deg)}66%{transform:translateY(-10rpx) scale(1.02) rotate(-1deg)}}
@keyframes petSleep{0%,100%{opacity:.94;transform:translateY(4rpx) rotate(-1deg) scale(.98)}50%{opacity:1;transform:translateY(-4rpx) rotate(1deg) scale(1.01)}}
@keyframes petDragged{from{transform:rotate(-5deg) scale(1.02)}to{transform:rotate(5deg) scale(1.07)}}
@keyframes petAvatarPop{from{transform:translateY(2rpx) scale(.96)}to{transform:translateY(-2rpx) scale(1.04)}}
@keyframes petPeek{0%,100%{transform:translateX(0) scale(.98)}50%{transform:translateX(6rpx) scale(1.03)}}
@keyframes petPulse{0%,100%{opacity:.72;transform:scale(.94)}50%{opacity:1;transform:scale(1.08)}}
@keyframes petSpark{0%,100%{opacity:.25;transform:translateY(3rpx) rotate(0) scale(.72)}50%{opacity:1;transform:translateY(-4rpx) rotate(35deg) scale(1.08)}}
@keyframes petCaret{0%,48%{opacity:1}49%,100%{opacity:0}}
@media (min-width:430px){.app-header{grid-template-columns:180rpx minmax(0,1fr);gap:16rpx 18rpx}.header-actions{justify-items:end}.primary-actions,.utility-actions{width:auto;display:flex;justify-content:flex-end}.action.primary{width:88rpx}.action.plan{width:142rpx}.icon-action{width:56rpx}.icon-action.labeled{width:auto;min-width:92rpx;padding:0 13rpx}}
@media (max-width:360px){.calendar-page{padding-left:10rpx;padding-right:10rpx}.app-header{gap:14rpx}.header-actions{gap:9rpx}.primary-actions,.utility-actions{gap:7rpx}.icon-action.labeled{padding:0 5rpx}.icon-action.labeled text{font-size:15rpx}.day-cell{height:102rpx}.summary-item{padding-left:7rpx;padding-right:7rpx}.summary-label{font-size:16rpx}}
